# Backend Configuration
BACKEND_PORT=8080
SMTP_PORT=2525
SMTP_HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=tempmail
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Email Configuration
EMAIL_DOMAIN=your-tempmail.info
EMAIL_EXPIRY_MINUTES=60

# Security
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this-in-production!!!
JWT_SECRET=your-jwt-secret-change-this

# CORS
FRONTEND_URL=http://localhost:3000

# WebSocket
WS_PING_INTERVAL=30s
WS_MAX_CONNECTIONS=1000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Frontend Configuration (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_EMAIL_DOMAIN=your-tempmail.info

